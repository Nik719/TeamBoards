{
  "info": {
    "name": "TeamBoard — B2B Knowledge Base API",
    "description": "Complete test suite for the TeamBoard API platform.\n\nIncludes:\n- All 11 official submission scenarios\n- 10 additional real-world example cases\n\nSetup:\n1. Set the `base_url` variable to http://localhost:8000\n2. Run Scenario 1 first — it auto-saves the token and api_key.\n3. Run scenarios in order for best results.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "teamboard-collection-v1"
  },
  "variable": [
    { "key": "base_url",  "value": "http://localhost:8000",  "type": "string" },
    { "key": "token",     "value": "",                        "type": "string" },
    { "key": "api_key",   "value": "",                        "type": "string" },
    { "key": "admin_token","value": "",                        "type": "string" }
  ],
  "item": [

    {
      "name": "── OFFICIAL SCENARIOS (11) ──",
      "item": [

        {
          "name": "1. Register a new company",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "pm.test('Has access token', () => { const d = pm.response.json(); pm.expect(d).to.have.property('access'); pm.collectionVariables.set('token', d.access); pm.collectionVariables.set('api_key', d.api_key); });",
                "pm.test('Has api_key', () => pm.expect(pm.response.json().api_key).to.be.a('string').with.lengthOf.above(10));",
                "pm.test('Has company_name', () => pm.expect(pm.response.json().company_name).to.equal('Acme Corp'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\",\n  \"company_name\": \"Acme Corp\",\n  \"email\": \"dev@acmecorp.com\"\n}"
            }
          }
        },

        {
          "name": "2. Register with duplicate username → 400",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                "pm.test('Has error message', () => { const d = pm.response.json(); pm.expect(JSON.stringify(d)).to.include('already exists'); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"anotherpass123\",\n  \"company_name\": \"Acme Corp Duplicate\",\n  \"email\": \"dup@acmecorp.com\"\n}"
            }
          }
        },

        {
          "name": "3. Login with valid credentials → 200 + JWT",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('Has access token', () => { const d = pm.response.json(); pm.expect(d).to.have.property('access'); pm.collectionVariables.set('token', d.access); });",
                "pm.test('Has company_name', () => pm.expect(pm.response.json().company_name).to.equal('Acme Corp'));",
                "pm.test('Has api_key', () => pm.expect(pm.response.json().api_key).to.be.a('string'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"securepass123\"\n}"
            }
          }
        },

        {
          "name": "4. Login with wrong password → 401",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                "pm.test('Has error detail', () => pm.expect(pm.response.json()).to.have.property('detail'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"acmecorp\",\n  \"password\": \"wrongpassword\"\n}"
            }
          }
        },

        {
          "name": "5. Query KB — no token → 401",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 401', () => pm.response.to.have.status(401));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/kb/query/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search\": \"select_related\"\n}"
            }
          }
        },

        {
          "name": "6. Query KB — valid token, keyword with results → 200",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('Has search field', () => pm.expect(pm.response.json().search).to.equal('select_related'));",
                "pm.test('Has count > 0', () => pm.expect(pm.response.json().count).to.be.above(0));",
                "pm.test('Has results array', () => pm.expect(pm.response.json().results).to.be.an('array').with.lengthOf.above(0));",
                "pm.test('Results have id, question, answer, category', () => { const r = pm.response.json().results[0]; pm.expect(r).to.have.all.keys('id','question','answer','category'); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search\": \"select_related\"\n}"
            }
          }
        },

        {
          "name": "7. Query KB — valid token, no matching results → 200 count 0",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200 (not 404)', () => pm.response.to.have.status(200));",
                "pm.test('Count is 0', () => pm.expect(pm.response.json().count).to.equal(0));",
                "pm.test('Results is empty array', () => pm.expect(pm.response.json().results).to.be.an('array').that.is.empty);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search\": \"xyzzy_nonexistent_term_12345\"\n}"
            }
          }
        },

        {
          "name": "8. Query KB — missing search field → 400",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                "pm.test('Has search error', () => pm.expect(pm.response.json()).to.have.property('search'));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },

        {
          "name": "9. Usage summary — CLIENT token → 403",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 403', () => pm.response.to.have.status(403));"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/admin/usage-summary/"
          }
        },

        {
          "name": "10. Usage summary — Admin token → 200 with stats",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get('base_url') + '/api/auth/login/',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ username: 'admin', password: 'Admin1234!' }) }",
                  "}, function(err, res) {",
                  "  if (!err) { pm.collectionVariables.set('admin_token', res.json().access); }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has total_queries', () => pm.expect(pm.response.json()).to.have.property('total_queries'));",
                  "pm.test('Has active_companies', () => pm.expect(pm.response.json()).to.have.property('active_companies'));",
                  "pm.test('Has top_search_terms array', () => pm.expect(pm.response.json().top_search_terms).to.be.an('array'));",
                  "pm.test('Top terms have search_term and count', () => { const terms = pm.response.json().top_search_terms; if(terms.length > 0) { pm.expect(terms[0]).to.have.all.keys('search_term','count'); } });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": "{{base_url}}/api/admin/usage-summary/"
          }
        },

        {
          "name": "11. Verify QueryLog created — PGAdmin check note",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('QueryLog written (check PGAdmin)', () => { pm.expect(pm.response.json().count).to.be.a('number'); console.log('Run in PGAdmin: SELECT * FROM api_querylog ORDER BY queried_at DESC LIMIT 5;'); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"search\": \"JWT\"\n}"
            }
          }
        }

      ]
    },

    {
      "name": "── EXAMPLE CASES (10) ──",
      "item": [

        {
          "name": "Ex-1. Register second company (BetaCorp)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "pm.test('Different api_key from first company', () => { const d = pm.response.json(); pm.expect(d.api_key).to.not.equal(pm.collectionVariables.get('api_key')); });"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"betacorp\",\n  \"password\": \"betapass123\",\n  \"company_name\": \"Beta Corporation\",\n  \"email\": \"api@betacorp.io\"\n}"
            }
          }
        },

        {
          "name": "Ex-2. Login BetaCorp and save token",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const d = pm.response.json(); pm.collectionVariables.set('beta_token', d.access);"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"betacorp\",\n  \"password\": \"betapass123\"\n}"
            }
          }
        },

        {
          "name": "Ex-3. Search for 'transaction.atomic'",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "pm.test('Returns relevant results', () => pm.expect(pm.response.json().count).to.be.above(0));"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"transaction.atomic\" }" }
          }
        },

        {
          "name": "Ex-4. Search for 'database index'",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"database index\" }" }
          }
        },

        {
          "name": "Ex-5. Search for 'Docker' (cloud category)",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Results include Docker entry', () => { const r = pm.response.json().results; const found = r.some(e => e.question.toLowerCase().includes('docker')); pm.expect(found).to.be.true; });"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"Docker\" }" }
          }
        },

        {
          "name": "Ex-6. Search with blank string → 400",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"\" }" }
          }
        },

        {
          "name": "Ex-7. Search for 'authentication authorization'",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"authentication\" }" }
          }
        },

        {
          "name": "Ex-8. Search for 'REST API'",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/kb/query/",
            "body": { "mode": "raw", "raw": "{ \"search\": \"REST API\" }" }
          }
        },

        {
          "name": "Ex-9. Usage summary — no token → 401",
          "event": [{
            "listen": "test",
            "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
          }],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/admin/usage-summary/"
          }
        },

        {
          "name": "Ex-10. Register with missing required field → 400",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));",
              "pm.test('Has validation error', () => pm.expect(Object.keys(pm.response.json()).length).to.be.above(0));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"incomplete_user\"\n}"
            }
          }
        }

      ]
    }

  ]
}
